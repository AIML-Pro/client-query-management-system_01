# Copy this file to `.env` and adjust as needed.

# Database back-end: "sqlite" (zero-setup, default) or "mysql"
DB_TYPE=sqlite

# --- MySQL settings (used only when DB_TYPE=mysql) ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=client_query_db

# --- SQLite settings (used only when DB_TYPE=sqlite) ---
SQLITE_PATH=client_query.db

# Dataset location
DATASET_CSV=synthetic_client_queries.csv
